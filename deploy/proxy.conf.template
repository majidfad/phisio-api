# Reverse proxy for zivan.me / test.zivan.me
# Public TLS is terminated by Cloudflare. Cloudflare connects to this origin over
# HTTP (:80). This proxy forwards to the web container (:80), which serves the SPA
# and proxies /api and /uploads to the API.
#
# CLIENT_MAX_BODY_SIZE is substituted at container start (see docker-compose).

# Restore the real visitor IP from Cloudflare (otherwise every request looks like
# it comes from a Cloudflare edge node).
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Clients reach Cloudflare over HTTPS; the origin sees plain HTTP.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      https;
}

# App hosts (production + test subdomain)
server {
    listen 80;
    listen [::]:80;
    server_name zivan.me www.zivan.me test.zivan.me;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    client_body_timeout 600s;
    proxy_connect_timeout 600s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    location = /healthz {
        return 200 "ok\n";
        access_log off;
    }

    # Resolve the web container name at request time so this proxy can start
    # even if the web container isn't up yet (avoids "host not found in upstream").
    resolver 127.0.0.11 valid=30s;
    set $upstream_web web;

    location / {
        proxy_pass http://$upstream_web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# Unknown hosts / direct IP on :80 → simple 404 page
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;

    location = /healthz {
        return 200 "ok\n";
        access_log off;
    }

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    location / {
        return 404;
    }
}

# Local-only probe port: always show the 404 page (127.0.0.1:8080)
server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;

    root /usr/share/nginx/html;

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    location / {
        return 404;
    }
}
