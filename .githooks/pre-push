#!/usr/bin/env sh
# Runs the complete Phisio backend test suite before allowing a push.
# Abort the push if any test fails. Bypass with: git push --no-verify

set -eu

# Discard refs listed on stdin (required by the pre-push protocol).
cat >/dev/null

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v dotnet >/dev/null 2>&1; then
  echo "pre-push: ERROR: 'dotnet' was not found on PATH." >&2
  echo "Install the .NET 8 SDK, then retry the push." >&2
  exit 1
fi

echo "pre-push: running complete test suite (dotnet test Phisio.sln)..."
echo

if ! dotnet test Phisio.sln; then
  echo >&2
  echo "pre-push: ERROR: Tests failed. Push aborted." >&2
  echo "Fix failing tests and try again." >&2
  echo "To bypass this hook only when absolutely necessary:" >&2
  echo "  git push --no-verify" >&2
  exit 1
fi

echo
echo "pre-push: all tests passed. Continuing push."
exit 0
